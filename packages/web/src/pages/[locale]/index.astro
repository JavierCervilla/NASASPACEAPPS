/*
 * The page of every other locale, under its own folder: /es/, /fr/, /de/
 * and /it/, and the pseudo-locale (/en-xa/) for the overflow tests unless
 * the build sets PSEUDO_LOCALE=0, as the production image does.
 */
import type { GetStaticPaths } from 'astro';
import Page from '../../components/Page.astro';
import {
  DEFAULT_LOCALE,
  LOCALES,
  PSEUDO_LOCALE,
  type UiLocale,
} from '../../i18n/locales';

export const getStaticPaths = (() => {
  const others: UiLocale[] = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
  if (process.env['PSEUDO_LOCALE'] !== '0') others.push(PSEUDO_LOCALE);
  return others.map((locale) => ({
    params: { locale: locale.toLowerCase() },
    props: { locale },
  }));
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
---

<Page locale={locale} />
