{
  "name": "ventana-lunar",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/sim",
    "packages/web",
    "packages/landing",
    "packages/server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @ventana/web",
    "server": "npm start -w @ventana/server",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w @ventana/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test --project=app && playwright test --project=landing && playwright test --project=onfoot --workers=2 && playwright test --project=bench",
    "lint": "eslint .",
    "headers": "node scripts/file-header.mjs --write",
    "headers:check": "node scripts/file-header.mjs --check",
    "ktx2:check": "node packages/web/scripts/moon-ktx2.mjs --verify",
    "dev:landing": "npm run dev -w @ventana/landing"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
