---
/**
 * The phone view until the timeline strip and the site card exist (VENT-4/5):
 * the 3D globe is desktop only (styles/globe.css), so below its breakpoint
 * this says so and lists the landing sites by name. Built from the curated
 * list the API serves, so it needs neither JavaScript nor the API.
 */
import curated from '../../../server/data/sites.json';

const names = curated.map((site) => site.name);
---

<section class="sites-mobile" aria-labelledby="sites-mobile-title">
  <p class="note">The 3D globe opens on larger screens.</p>
  <h2 id="sites-mobile-title">Landing sites</h2>
  <ul>
    {names.map((name) => <li>{name}</li>)}
  </ul>
</section>

<style>
  .sites-mobile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note {
    margin: 0 0 var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  h2 {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: var(--radius);
    background: var(--surface);
  }

  li {
    padding: 11px 16px;
    font-size: 0.9375rem;
    line-height: 1.35;
    letter-spacing: -0.005em;
  }

  li + li {
    border-top: 1px solid var(--surface-edge);
  }

  /* Must match DESKTOP_QUERY in src/globe/boot.ts. */
  @media (min-width: 768px) {
    .sites-mobile {
      display: none;
    }
  }
</style>
