/*
 * The Liquid glass's refraction (VENT-27): one SVG filter for every
 * surface, read by `backdrop-filter: url(#glass-liquid)` in glass.css. A
 * slow fractal noise displaces what lies under the glass, as thick
 * moulded glass would. Presentation attributes only: the page's CSP
 * allows no style attributes.
 */
import '../styles/glass.css';
---

<svg class="glass-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter
    id="glass-liquid"
    x="0"
    y="0"
    width="100%"
    height="100%"
    color-interpolation-filters="sRGB"
  >
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.006 0.009"
      numOctaves="2"
      seed="7"
      result="ripple"></feTurbulence>
    <feDisplacementMap
      in="SourceGraphic"
      in2="ripple"
      scale="36"
      xChannelSelector="R"
      yChannelSelector="G"></feDisplacementMap>
  </filter>
</svg>
