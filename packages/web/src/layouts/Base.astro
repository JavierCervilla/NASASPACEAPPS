---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080b" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Dev tools (performance readout, breadcrumbs, Spector.js on request):
      // the dev server, or a build made with PUBLIC_PERF_HUD=1. In a
      // production build the condition is a constant false and the bundler
      // drops the import; scripts/check-no-devtools.mjs proves it after
      // every build.
      if (import.meta.env.DEV || import.meta.env.PUBLIC_PERF_HUD === '1') {
        void import('../devtools/boot').then(({ devTools }) => devTools());
      }
    </script>
  </body>
</html>
