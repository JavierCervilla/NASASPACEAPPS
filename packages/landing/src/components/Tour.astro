import { catalogueOf, translator } from '../i18n/catalogue';
import type { Locale } from '../i18n/locales';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = translator(catalogueOf(locale));
// The app's own views at IM-2 on 22 Nov 2026, 20:00 UTC, a landing window
// (scripts/tour-shots.mjs; ASSETS.md).
const shots = [
  ['globe', t('tour.globeTitle'), t('tour.globeBody'), t('tour.globeAlt')],
  ['onfoot', t('tour.footTitle'), t('tour.footBody'), t('tour.footAlt')],
  ['dsn', t('tour.dsnTitle'), t('tour.dsnBody'), t('tour.dsnAlt')],
] as const;
---

<section class="section" id="tour" aria-labelledby="tour-title">
  <p class="eyebrow">{t('tour.eyebrow')}</p>
  <h2 class="section__title" id="tour-title">{t('tour.title')}</h2>
  <div class="tour">
    {
      shots.map(([name, title, body, alt]) => (
        <figure class="shot">
          <img
            class="shot__image"
            src={`/media/tour-${name}.webp`}
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            alt={alt}
          />
          <figcaption class="shot__caption">
            <strong>{title}</strong>
            <span>{body}</span>
          </figcaption>
        </figure>
      ))
    }
    <figure class="shot shot--phone">
      <div class="shot__phone">
        <img
          src="/media/tour-phone.webp"
          width="390"
          height="844"
          loading="lazy"
          decoding="async"
          alt={t('tour.phoneAlt')}
        />
      </div>
      <figcaption class="shot__caption">
        <strong>{t('tour.phoneTitle')}</strong>
        <span>{t('tour.phoneBody')}</span>
      </figcaption>
    </figure>
  </div>
</section>
