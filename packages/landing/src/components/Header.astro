import { catalogueOf, translator } from '../i18n/catalogue';
import { appPath, landingPath, type Locale } from '../i18n/locales';
import Mark from './Mark.astro';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = translator(catalogueOf(locale));
const links = [
  ['#how', t('nav.how')],
  ['#science', t('nav.science')],
  ['#tour', t('nav.tour')],
  ['#team', t('nav.team')],
] as const;
---

<header class="top">
  <a class="top__brand" href={landingPath(locale)} aria-label={t('nav.home')}>
    <Mark />
    <span>Ventana Lunar</span>
  </a>
  <nav class="top__nav" aria-label={t('nav.label')}>
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <a class="button button--primary top__open" href={appPath(locale)}>
    {t('nav.open')}
  </a>
</header>
