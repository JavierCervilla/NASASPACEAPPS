---
import curated from '../../../server/data/sites.json';
import LunarApp from '../components/LunarApp';
import Base from '../layouts/Base.astro';
import { toPhoneSite, type PhoneSite } from '../phone/phone-site';
import '../styles/globe.css';
import '../styles/phone.css';

// Same origin in production: the API sits behind the same domain.
const sitesUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/v1/sites`;

// The phone's site picker reads the curated list the API serves, built in.
const sites: PhoneSite[] = (curated as PhoneSite[]).map(toPhoneSite);

// Only the globe exists yet; the other two views are later trajectories.
const views = [
  { label: 'Globe', current: true },
  { label: 'Polar map', current: false },
  { label: 'Horizon', current: false },
];
---

<Base
  title="Ventana Lunar"
  description="When can you land at the lunar south pole? NASA Space Apps Challenge 2026, Madrid."
>
  <div class="page">
    <header class="bar">
      <div class="titles">
        <h1 class="title">Ventana Lunar</h1>
        <p class="subtitle">When can you land at the lunar south pole?</p>
      </div>
      <nav aria-label="View" class="views">
        {
          views.map(({ label, current }) =>
            current ? (
              <a href="./" aria-current="page">
                {label}
              </a>
            ) : (
              <span aria-disabled="true" title="Coming soon">
                {label}
              </span>
            ),
          )
        }
      </nav>
    </header>
    <main class="stage">
      <LunarApp
        client:load
        sitesUrl={sitesUrl}
        base={import.meta.env.BASE_URL}
        selectedId="im2-athena"
        sites={sites}
      />
    </main>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 14px 24px;
    background: var(--chrome);
    backdrop-filter: blur(20px) saturate(180%);
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* Tracking tightens as the size grows (apple-design §15). */
  .title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.022em;
  }

  .subtitle {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  .views {
    display: flex;
    padding: 2px;
    border-radius: 10px;
    background: var(--fill);
  }

  .views > * {
    padding: 9px 16px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .views [aria-current='page'] {
    background: var(--fill-selected);
    box-shadow: var(--fill-selected-shadow);
    color: var(--text);
  }

  .views [aria-disabled='true'] {
    opacity: 0.55;
    cursor: default;
  }

  .stage {
    flex: 1;
    display: flex;
    padding: 16px 24px;
  }

  @media (prefers-reduced-transparency: reduce) {
    .bar {
      backdrop-filter: none;
    }
  }

  /* Phones get their own glass bar (components/phone/PhoneBar.tsx). */
  @media (max-width: 767.98px) {
    .bar {
      display: none;
    }

    .stage {
      padding: 0;
    }
  }
</style>
