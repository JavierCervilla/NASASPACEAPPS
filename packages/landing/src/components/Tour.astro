import { catalogueOf, translator } from '../i18n/catalogue';
import type { Locale } from '../i18n/locales';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = translator(catalogueOf(locale));
// The app's own views at IM-2 on 22 Nov 2026, 20:00 UTC, a landing window
// (scripts/tour-shots.mjs; ASSETS.md).
// Each card names the view, then says what a person does with it.
const shots = [
  ['globe', 'globe', 'globeAlt'],
  ['onfoot', 'foot', 'footAlt'],
  ['dsn', 'dsn', 'dsnAlt'],
] as const;
const words = (key: 'globe' | 'foot' | 'dsn' | 'phone') => ({
  name: t(`tour.${key}Name`),
  title: t(`tour.${key}Title`),
  body: t(`tour.${key}Body`),
});
const phone = words('phone');
---

<section class="section" id="tour" aria-labelledby="tour-title">
  <p class="eyebrow">{t('tour.eyebrow')}</p>
  <h2 class="section__title section__title--lead" id="tour-title">
    {t('tour.title')}
  </h2>
  <p class="section__lead">{t('tour.lead')}</p>
  <div class="tour">
    {
      shots.map(([file, key, alt]) => {
        const w = words(key);
        return (
          <figure class="shot">
            <img
              class="shot__image"
              src={`/media/tour-${file}.webp`}
              width="1440"
              height="900"
              loading="lazy"
              decoding="async"
              alt={t(`tour.${alt}`)}
            />
            <figcaption class="shot__caption">
              <span class="shot__name">{w.name}</span>
              <strong>{w.title}</strong>
              <span>{w.body}</span>
            </figcaption>
          </figure>
        );
      })
    }
    <figure class="shot shot--phone">
      <div class="shot__phone">
        <img
          src="/media/tour-phone.webp"
          width="390"
          height="844"
          loading="lazy"
          decoding="async"
          alt={t('tour.phoneAlt')}
        />
      </div>
      <figcaption class="shot__caption">
        <span class="shot__name">{phone.name}</span>
        <strong>{phone.title}</strong>
        <span>{phone.body}</span>
      </figcaption>
    </figure>
  </div>
</section>
