import '../styles/base.css';
import '../styles/hero.css';
import '../styles/sections.css';
import { catalogueOf, translator } from '../i18n/catalogue';
import { LOCALES, landingPath, type Locale } from '../i18n/locales';
import {
  DESKTOP_QUERY,
  FULL_MOTION,
  PHONE_QUERY,
  narrowed,
  startUrl,
} from '../hero/film-plan';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = translator(catalogueOf(locale));
const site = Astro.site;
const href = (l: Locale) =>
  site ? new URL(landingPath(l), site).href : landingPath(l);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080b" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={href(locale)} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href('en')} />
    <link rel="icon" href="/app/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/app/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/app/icons/apple-touch-icon.png" />
    <link rel="preload" as="image" href={startUrl('phone')}
      media={narrowed(PHONE_QUERY, FULL_MOTION)} fetchpriority="high" />
    <link rel="preload" as="image" href={startUrl('desktop')}
      media={narrowed(DESKTOP_QUERY, FULL_MOTION)} fetchpriority="high" />
  </head>
  <body>
    <slot />
  </body>
</html>
