/*
 * What tells browsers and search engines this page exists in five
 * languages: a `rel="alternate"` link per locale and `x-default` (the
 * English page), and the canonical address on the primary domain when
 * the build knows it (SITE_URL). The English page at `/` also carries the
 * first-visit redirect (i18n/first-visit.ts), inline so it runs before the
 * page paints; scripts/csp-header.mjs allows it by its hash. And the locale's
 * web app manifest, so the app installs in the page's language.
 */
import { firstVisitScript } from '../i18n/first-visit';
import { DEFAULT_LOCALE, PSEUDO_LOCALE, type UiLocale } from '../i18n/locales';
import { alternates, canonicalHref, localePath } from '../i18n/routes';
import { MANIFEST_FILE } from '../pwa/manifest-route';

interface Props {
  readonly locale: UiLocale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = alternates(base, Astro.site);
// The pseudo-locale is never indexed, so it names no canonical page.
const canonical =
  locale === PSEUDO_LOCALE ? null : canonicalHref(base, locale, Astro.site);
// Each offered locale installs as its own app (pwa/manifest.ts).
const manifest =
  locale === PSEUDO_LOCALE ? null : `${localePath(base, locale)}${MANIFEST_FILE}`;
---

{manifest ? <link rel="manifest" href={manifest} /> : null}
{canonical ? <link rel="canonical" href={canonical} /> : null}

{
  links.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))
}
{locale === PSEUDO_LOCALE ? <meta name="robots" content="noindex" /> : null}
{
  locale === DEFAULT_LOCALE ? (
    <script is:inline set:html={firstVisitScript(base)} />
  ) : null
}
